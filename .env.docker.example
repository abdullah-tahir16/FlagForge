NODE_ENV=production

# Host ports exposed by Docker Compose.
BACKEND_PORT=3001
FRONTEND_PORT=5174
FRONTEND_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_SHOW_DEMO_CREDENTIALS=true

# Service-to-service values used by Docker Compose containers.
POSTGRES_HOST=postgres
POSTGRES_HOST_PORT=5432
POSTGRES_PORT=5432
POSTGRES_USER=flagforge
POSTGRES_PASSWORD=flagforge
POSTGRES_DB=flagforge
DATABASE_SSL=false
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true

REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_HOST_PORT=6379
REDIS_PORT=6379
EVALUATION_CACHE_TTL_SECONDS=300

# Demo-only secrets. Replace before any shared deployment.
JWT_SECRET=change-me-access-secret
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=flagforge_refresh
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
