NODE_ENV=development

# Local pnpm development uses localhost because backend/frontend run on the host.
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5432
POSTGRES_PORT=5432
POSTGRES_USER=flagforge
POSTGRES_PASSWORD=flagforge
POSTGRES_DB=flagforge

REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379
EVALUATION_CACHE_TTL_SECONDS=300

BACKEND_PORT=3001
FRONTEND_PORT=5174
FRONTEND_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:3001/api/v1

# For full Docker Compose values, use .env.docker.example.

JWT_SECRET=change-me-access-secret
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=flagforge_refresh
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
